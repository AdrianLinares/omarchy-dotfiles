# Fish completions are auto-generated by carapace at shell startup.
# Do not commit them; they are derived state and machine-specific.
.config/fish/completions/

# Fish universal-variable history/state can leak machine-specific paths.
# We commit fish_variables (it has no secrets here) but flag completions.
.config/fish/fish_history

# Omarchy current-theme state is runtime-generated; the repo already tracks
# samples under .config/omarchy/current/theme/.
.config/omarchy/current/

# Common dev artifacts
.DS_Store
*.log
*.swp
*.swo